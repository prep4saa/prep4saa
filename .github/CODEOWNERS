# ===================================================================
# CODEOWNERS — 디렉토리/파일별 자동 리뷰어 지정
# 형식: <패턴>  <@사용자 또는 @팀>
# 우선순위: 아래쪽 규칙이 위쪽보다 우선 (마지막 매칭 승)
#
# 효과:
# - PR 생성 시 해당 영역의 owner가 자동으로 리뷰어로 지정됨
# - 브랜치 보호 규칙에서 "Require review from Code Owners" 활성화 시
#   owner 승인 없이는 머지 불가
# ===================================================================

# 기본 owner (어떤 파일이든 매칭 안 되면 이 사람)
*       @choijai

# -----------------------------------------------------
# 인프라 (위험도 최상 — 잘못 건드리면 운영 다운)
# -----------------------------------------------------
/infra/                       @choijai
/.github/workflows/            @choijai
/.github/CODEOWNERS            @choijai

# -----------------------------------------------------
# 보안 관련 코드 (Firebase 인증, 결제)
# -----------------------------------------------------
/src/firebase.ts              @choijai
/src/auth/**                  @choijai
/lambda-webhook/**            @choijai

# -----------------------------------------------------
# 빌드 설정
# -----------------------------------------------------
package.json                  @choijai
package-lock.json             @choijai
vite.config.*                 @choijai
tsconfig*.json                @choijai
